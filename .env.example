# ====================================================================
# THYNK LMS — ENVIRONMENT CONFIGURATION & API KEYS
# Copy this file to .env and fill in your actual credentials.
# Vite requires frontend variables to be prefixed with VITE_
# ====================================================================

# --- SUPABASE CONFIGURATION ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# --- GOOGLE OAUTH CONFIGURATION ---
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- RAZORPAY PAYMENT GATEWAY ---
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# --- CLOUDFLARE STREAM VIDEO HOSTING ---
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_STREAM_API_TOKEN=your_cloudflare_stream_token_here

# --- TRANSACTIONAL EMAIL PROVIDER (Resend / Brevo) ---
# Resend: Get free API key from https://resend.com
VITE_EMAIL_API_KEY=re_your_resend_api_key_here
VITE_EMAIL_FROM_ADDRESS=THYNK Digital Academy <onboarding@resend.dev>

# --- TRANSACTIONAL SMS PROVIDER (2Factor / Fast2SMS) ---
# 2Factor.in: Indian OTP gateway (https://2factor.in)
VITE_2FACTOR_API_KEY=your_2factor_api_key_here
# Fast2SMS: Indian Quick OTP route (https://fast2sms.com)
VITE_FAST2SMS_API_KEY=your_fast2sms_api_key_here
# Generic SMS API Key fallback
VITE_SMS_API_KEY=your_sms_gateway_key_here

# --- META WHATSAPP BUSINESS PLATFORM ---
VITE_WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
VITE_WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
VITE_WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here
